# Copy to .env.local for development, and set these on the machine that runs
# `npm run build` for production. They are baked into the exported HTML at
# build time, so a change needs a rebuild — not just a restart.

# Canonical origin of this marketing site. Used for canonical tags, Open Graph
# urls, the sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://trackbells.com

# Where the ERP application lives. Every "Sign in" and "Create workspace" link
# points here.
NEXT_PUBLIC_APP_URL=https://app.trackbells.com

# Backend that receives the demo enquiry form (POST /api/support/ticket).
# This origin must be listed in the backend's CORS_ALLOWED_ORIGINS.
NEXT_PUBLIC_API_URL=https://api.trackbells.com
